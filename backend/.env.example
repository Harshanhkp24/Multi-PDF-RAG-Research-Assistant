# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3
OLLAMA_EMBED_MODEL=nomic-embed-text

# Provider: ollama | openai | groq
LLM_PROVIDER=ollama

# OpenAI / Groq (optional, for Phase 7)
# OPENAI_API_KEY=
# GROQ_API_KEY=

# ChromaDB
CHROMA_PERSIST_DIR=../data/chroma
CHROMA_COLLECTION_NAME=research_docs

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=4

# Upload limits
MAX_UPLOAD_SIZE_MB=50

# Database
DATABASE_URL=sqlite+aiosqlite:///../data/chat.db

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# App
APP_NAME=Multi-PDF RAG Research Assistant
DEBUG=true
